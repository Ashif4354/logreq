# Target server URL to proxy and forward incoming requests to.
# If left empty or unset, logreq acts as a fake backend (mock mode).
# PROXY_TARGET=http://localhost:8091

# Timezone offset format: +[H]H:MM or -[H]H:MM (e.g. +5:30, +05:30, -02:00).
# Defaults to UTC (+00:00) if unset or invalid format.
# TIMEZONE=+5:30
